PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local development: the separate variables below.
#
# Hosted (Neon, Render, Supabase, Railway, Heroku): set DATABASE_URL instead, to
# the connection string the provider gives you, and leave the DB_* ones unset.
# TLS is then on by default, which hosted PostgreSQL requires.
#
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=run_league

# Force TLS on or off when the default guess is wrong — a local database reached
# by URL (false), or a provider needing TLS with the separate variables (true).
# DB_SSL=true

# Verify the provider's certificate rather than only encrypting, where they
# publish a CA bundle. Paste the PEM as one line, using \n for the newlines.
# DB_CA_CERT=

# Lower this when the database caps connections — a serverless free tier does.
# DB_POOL_MAX=10

# Auth — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_your_own_see_comment_above
JWT_EXPIRES_IN=7d

# ── Connected accounts (RU-16 wearables, RU-49 social) ────────────────────────
# Every provider is inert until its credentials are set here. Register an app with
# the provider, then set its redirect URI to:
#   <OAUTH_REDIRECT_BASE>/<provider>/callback
# e.g. http://localhost:3000/api/connections/fitbit/callback
OAUTH_REDIRECT_BASE=http://localhost:3000/api/connections

# Fitbit — https://dev.fitbit.com/apps/new  (activity importing is implemented)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Garmin — https://developer.garmin.com/gc-developer-program/health-api/
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Samsung Health — https://developer.samsung.com/health
SAMSUNG_CLIENT_ID=
SAMSUNG_CLIENT_SECRET=

# Apple Health needs no credentials: it is read on-device and requires a native build.

# Social sharing (RU-49)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# ── Weather (no key or account needed) ───────────────────────────────────────
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# DEFAULT_LATITUDE=1.3521
# DEFAULT_LONGITUDE=103.8198

# ── Testing only ─────────────────────────────────────────────────────────────
# Endpoint overrides let the OAuth flow be tested against a local stub.
# Leave unset in production. e.g. FITBIT_TOKEN_URL, FITBIT_API_URL

# ── AI fitness planner (optional) ─────────────────────────────────────────────
# Leave AI_PROVIDER unset and the planner still works: plans are built from the
# standard progression rules instead, and the app says which was used. Nothing
# about the feature requires an account anywhere.
#
# Only derived figures are sent to the provider — weekly volume, run count, goal,
# and the risk LEVEL. Declared conditions, injury descriptions, names and emails
# are deliberately never sent.
#
# AI_PROVIDER=anthropic        # anthropic | openai | none (default: none)
# AI_API_KEY=
# AI_MODEL=                    # optional; each provider has a sensible default
# AI_TIMEOUT_MS=20000

# ── Rate limits (optional; the defaults are sensible) ─────────────────────────
# RATE_LIMIT_PER_MINUTE=300    # per user or IP, across the API
# RATE_LIMIT_AUTH=20           # failed sign-ins per IP per 15 minutes
# RATE_LIMIT_AI_PER_HOUR=10    # plan generations per user per hour

# ── Email verification at sign-up (optional, off by default) ──────────────────
# Off: the sign-up flow skips the verification step entirely and anyone can
# register with an address they do not own. On: a 6-digit code is emailed and
# registration is refused without it.
#
# Turn it on only once a mail provider below is set. With it on and no provider,
# sign-up collects an address and then never delivers a code — the server warns
# loudly at startup in production if you do this.
#
# The app reads this from GET /api/auth/config at run time rather than being
# built with it, so switching it on takes effect on apps already installed.
#
# REQUIRE_EMAIL_VERIFICATION=true

# Resend — https://resend.com — the recommended provider for a free host: it is
# an HTTPS API, so it works where SMTP ports are blocked (Render blocks some).
# RESEND_API_KEY=
# MAIL_FROM=Run League <onboarding@yourdomain.com>

# Or any SMTP server. Needs `npm install nodemailer`, which is otherwise not
# required — it is imported only if this is set.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
#
# No domain of your own? Resend's default sender only reaches your own account
# address. Brevo / Mailjet / SendGrid let you verify a single email instead of a
# domain, and Gmail works over SMTP with an App Password (not your password):
#   SMTP_URL=smtps://you@gmail.com:app-password@smtp.gmail.com:465
# DEPLOY.md has the trade-offs. Check any of them with:  npm run mail:test
#   npm run mail:test -- you@example.com

# With neither set, nothing is emailed: the code is printed to the server log and
# returned in the API response as `devCode`, so sign-up can be completed in
# development and by the test suites. Never happens when NODE_ENV=production.

# ── Passwords ────────────────────────────────────────────────────────────────
# The rule is in control/PasswordPolicy.js, not configurable here, and applies
# everywhere a password is set: self-registration, admin-created users, admin
# password resets and `npm run admin:create`. At least 8 characters with a letter
# and a number, not a commonly used password, and not containing the person's own
# name or email. GET /api/auth/config publishes it so the app can show the rules
# as the person types.
